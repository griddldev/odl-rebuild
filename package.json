{
  "name": "sage",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "dev": "vite",
    "build": "vite build",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/sage.pot --include=\"theme.json,patterns,app,resources\"",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/sage.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
  },
  "lint-staged": {
    "*.{css,blade.php,js,jsx}": "prettier --write"
  },
  "devDependencies": {
    "@roots/vite-plugin": "^2.0.0",
    "@shufo/prettier-plugin-blade": "^1.16.2",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@wordpress/block-editor": "^16.2.0",
    "@wordpress/blocks": "^15.26.0",
    "@wordpress/components": "^39.0.0",
    "@wordpress/dom-ready": "^4.53.0",
    "@wordpress/element": "^8.5.0",
    "laravel-vite-plugin": "^3.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  }
}
